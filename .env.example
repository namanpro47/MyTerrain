# Local chapter server only. Copy to .env in this repository root.
# Paste the key after =, then restart the chapter service.
# Never copy this file into Assets, StreamingAssets, Builds/Web or a public folder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TERRA_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
