+        void BuildMeadowSward()
+        {
+            // Artist grass meshes form low interlocking patches, rather than isolated giant tufts.
+            // Patch shape, species and mowing-like gaps are decorative, not an observed land condition.
+            var tuft=Resources.Load<GameObject>("Nature/Grass_Common_Short");
+            var wispy=Resources.Load<GameObject>("Nature/Grass_Wispy_Short");
+            var rng=new System.Random(230418);
+            float J(float a,float b)=>Mathf.Lerp(a,b,(float)rng.NextDouble());
+            for(float cz=zmin;cz<zmax;cz+=100)for(float cx=xmin;cx<xmax;cx+=100)
+            {
+                var low=new List<Matrix4x4>();var tips=new List<Matrix4x4>();
+                for(float z=cz+1;z<Mathf.Min(cz+100,zmax-2);z+=2.4f)
+                for(float x=cx+1;x<Mathf.Min(cx+100,xmax-2);x+=2.4f)
+                {
+                    float px=x+J(-.9f,.9f),pz=z+J(-.9f,.9f);
+                    float mass=Mathf.PerlinNoise((px+430)*.023f,(pz+720)*.023f);
+                    float rim=Mathf.PerlinNoise(px*.16f+70,pz*.16f+90);
