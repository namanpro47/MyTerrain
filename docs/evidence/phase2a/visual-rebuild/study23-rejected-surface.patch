+                    if(world.sites.Any(site=>Contains(site.polygon,px,pz)))continue;
+                    float breadth=J(3.0f,4.6f),height=J(.48f,.80f);
+                    low.Add(Matrix4x4.TRS(new Vector3(px,Height(px,pz),pz),Quaternion.Euler(0,J(0,360),0),new Vector3(breadth,height,breadth)));
+                    if(mass>.65f&&rng.NextDouble()<.06)
+                        tips.Add(PlantMatrix(wispy,px,pz,J(.8f,1.25f),J(0,360)));
+                }
+                var nature=root.gameObject.AddComponent<InstancedNature>();
+                nature.Add(tuft,low,new Color(.86f,.94f,.86f),true);
+                nature.Add(wispy,tips,new Color(.86f,.94f,.86f),true);
+            }
